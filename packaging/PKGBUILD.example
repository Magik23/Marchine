# Maintainer: Pierre Dionne <hello@albenoir.com>
# Production AUR template.
# Generate packaging/PKGBUILD (and .SRCINFO when makepkg is available) with:
#   ./packaging/finalize-aur.sh 1.22.1
#
# The version and checksum placeholders below are replaced by finalize-aur.sh
# after the release tag exists. Never submit this template itself to the AUR.

pkgname=marchine
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Game Machinery — restrained terminal-native game launcher, MAME-first'
arch=('x86_64')
url='https://github.com/Magik23/Marchine'
license=('MIT')
depends=('hicolor-icon-theme')
makedepends=('go')
optdepends=('mame: automatic Arcade indexing and launching')
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('@SHA256@')

build() {
  cd "$srcdir/Marchine-$pkgver"

  export GOTOOLCHAIN=local
  export GOPROXY=off
  CGO_ENABLED=0 go build \
    -mod=vendor \
    -trimpath \
    -buildvcs=false \
    -buildmode=pie \
    -ldflags "-X main.version=$pkgver" \
    -o marchine \
    ./cmd/marchine
}

check() {
  cd "$srcdir/Marchine-$pkgver"

  export GOTOOLCHAIN=local
  export GOPROXY=off

  unformatted="$(gofmt -l $(find cmd internal -name '*.go' -type f))"
  if [[ -n "$unformatted" ]]; then
    printf 'Go files need gofmt:\n%s\n' "$unformatted" >&2
    return 1
  fi

  go test -mod=vendor -count=1 ./...
  go vet -mod=vendor ./...
  test "$(./marchine --version)" = "marchine $pkgver"
}

package() {
  cd "$srcdir/Marchine-$pkgver"

  install -Dm755 marchine "$pkgdir/usr/bin/marchine"
  install -Dm644 packaging/marchine.desktop "$pkgdir/usr/share/applications/marchine.desktop"
  install -Dm644 assets/icons/marchine-128.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/marchine.png"
  install -Dm644 assets/icons/marchine-256.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/marchine.png"
  install -Dm644 assets/icons/marchine-512.png "$pkgdir/usr/share/icons/hicolor/512x512/apps/marchine.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 config.example.toml "$pkgdir/usr/share/doc/$pkgname/config.example.toml"
  install -Dm644 packaging/marchine.desktop.in "$pkgdir/usr/share/doc/$pkgname/examples/marchine.desktop.in"
  install -Dm644 packaging/omarchy/marchine.lua "$pkgdir/usr/share/doc/$pkgname/examples/omarchy/marchine.lua"

  while IFS= read -r license_file; do
    rel="${license_file#vendor/}"
    install -Dm644 "$license_file" "$pkgdir/usr/share/licenses/$pkgname/third-party/$rel"
  done < <(find vendor -type f \( -iname 'LICENSE*' -o -iname 'COPYING*' -o -iname 'NOTICE*' \) -print | sort)
}
